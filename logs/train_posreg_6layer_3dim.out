Overriding config with config/train_posreg_6layer_until_mlp_3dim.py:
# Configuration for Position Regression - 6 Layer - Freeze Until First MLP - 3D Embeddings
# Same setup but with only 3 neurons as embedding dimension
# For studying position encoding in minimal capacity setting

# I/O
out_dir = "out-posreg-6layer-until-mlp-3dim"
eval_interval = 500
log_interval = 50
eval_iters = 200
always_save_checkpoint = True

# Wandb logging
wandb_log = True
wandb_project = "position-regression"
wandb_run_name = "nope-6layer-until-first-mlp-3dim"

# Data
dataset = "openwebtext"
gradient_accumulation_steps = 4
batch_size = 64
block_size = 128

# Model - 6 layers with 3D embeddings
n_layer = 6
n_head = 1  # Must divide n_embd evenly
n_embd = 3  # Only 3 neurons!
dropout = 0.0
bias = False

# NoPE
use_positional_embedding = False
norm_type = "layernorm"

# Training mode
freeze_transformer = False
freeze_attention_only = False
freeze_until_first_mlp = True  # Freeze embeddings + block0 attn/norms, train from first MLP
use_regression = True          # MSE loss
compute_lm_loss = True         # Also compute LM perplexity

# AdamW optimizer
learning_rate = 3e-4
max_iters = 20000
weight_decay = 0.1
warmup_iters = 1000
lr_decay_iters = 20000
min_lr = 3e-5

# System
device = "cuda"
dtype = "bfloat16"
compile = True
seed = 42

tokens per iteration will be: 32,768
