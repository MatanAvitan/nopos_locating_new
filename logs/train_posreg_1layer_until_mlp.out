Overriding config with config/train_posreg_1layer_until_mlp.py:
# Configuration for Position Regression - 1 Layer - Freeze Until First MLP
# Same setup as 6-layer but with only 1 transformer block
# Freeze embeddings + first block's attention/norms, train from first MLP onwards
# Uses regression loss (MSE) and computes LM perplexity

# I/O
out_dir = "out-posreg-1layer-until-mlp"
eval_interval = 500
log_interval = 50
eval_iters = 200
always_save_checkpoint = True

# Wandb logging
wandb_log = True
wandb_project = "position-regression"
wandb_run_name = "nope-1layer-until-first-mlp"

# Data
dataset = "openwebtext"
gradient_accumulation_steps = 4
batch_size = 64
block_size = 128

# Model - 1 layer (same embedding dim as 6-layer)
n_layer = 1
n_head = 12
n_embd = 768
dropout = 0.0
bias = False

# NoPE
use_positional_embedding = False
norm_type = "layernorm"

# Training mode
freeze_transformer = False
freeze_attention_only = False
freeze_until_first_mlp = (
    True  # Freeze embeddings + block0 attn/norms, train from first MLP
)
use_regression = True  # MSE loss
compute_lm_loss = True  # Also compute LM perplexity

# AdamW optimizer
learning_rate = 3e-4
max_iters = 20000
weight_decay = 0.1
warmup_iters = 1000
lr_decay_iters = 20000
min_lr = 3e-5

# System
device = "cuda"
dtype = "bfloat16"
compile = True
seed = 42

